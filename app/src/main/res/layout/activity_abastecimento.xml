<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc"
    android:fillViewport="true"
    android:paddingHorizontal="24dp"
    tools:context=".Abastecimento">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="16dp">

            <ImageButton
                android:id="@+id/iBtnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:background="#f8fafc"
                android:padding="0dp"
                android:src="@drawable/vetor_seta_voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Abastecimento"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <!-- Veículo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Veículo"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spVeiculo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_branco_arredondado_com_borda"
                android:paddingHorizontal="4dp" />

            <!-- Litros / Valor por litro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:divider="@drawable/gap"
                android:orientation="horizontal"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Litros"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etLitros"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_branco_arredondado_com_borda"
                        android:digits="0123456789.,"
                        android:hint="45 L"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748b"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Valor / Litro"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etValorLitro"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_branco_arredondado_com_borda"
                        android:digits="0123456789.,"
                        android:hint="R$ 5,89"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748b"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Valor total / KM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:divider="@drawable/gap"
                android:orientation="horizontal"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Valor Total"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etValorTotal"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_verde_claro_arredondado_com_borda"
                        android:digits="0123456789.,"
                        android:hint="R$ 265,05"
                        android:inputType="numberDecimal"
                        android:padding="12dp"
                        android:textColor="#0d9488"
                        android:textColorHint="#0d9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="KM Atual"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etKm"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_branco_arredondado_com_borda"
                        android:hint="84200"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748b"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Posto / Data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:divider="@drawable/gap"
                android:orientation="horizontal"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Posto"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPosto"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_branco_arredondado_com_borda"
                        android:hint="Ipiranga Centro"
                        android:inputType="textCapWords"
                        android:padding="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748b"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Data"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etData"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_branco_arredondado_com_borda"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="14/10/2026"
                        android:inputType="none"
                        android:padding="12dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#64748b"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Histórico de consumo (será preenchido no próximo passo) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_branco_arredondado_com_borda"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Histórico de Consumo (km/L)"
                    android:textColor="#0f172a"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSalvarAbastecimento"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:background="@drawable/btn_borda_arredondada"
                android:text="Salvar Abastecimento"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>