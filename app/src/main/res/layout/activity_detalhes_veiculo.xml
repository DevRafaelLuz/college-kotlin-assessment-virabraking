<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc"
    tools:context=".DetalhesVeiculo">

    <LinearLayout
        android:id="@+id/llBarraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/iBtnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/vetor_seta_voltar"
            android:background="#f8fafc"
            android:layout_marginEnd="12dp"
            android:padding="0dp"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalhes do Veículo"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="20sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/llBarraSuperior"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivFotoVeiculo"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="#0d9488" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffffff"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomeVeiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Veículo"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvModelo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748b"
                        android:text="Modelo" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:src="@drawable/vetor_circulo_divisor" />

                    <TextView
                        android:id="@+id/tvAno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748b"
                        android:text="Ano" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:src="@drawable/vetor_circulo_divisor" />

                    <TextView
                        android:id="@+id/tvPlaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#64748b"
                        android:text="ABC-1234" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/tvKmVeiculo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:text="0 km"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_cinza_claro_arredondado" />

                    <TextView
                        android:id="@+id/tvStatusOleo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0d9488"
                        android:text="Óleo em dia"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_verde_claro_arredondado" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:divider="@drawable/gap"
                android:showDividers="middle"
                android:paddingVertical="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistorico"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textColor="#64748b"
                    android:text="Histórico"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCombustivel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textColor="#64748b"
                    android:text="Combustível"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocumentos"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:textColor="#64748b"
                    android:text="Documentos"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvTituloLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Histórico de Manutenções"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>