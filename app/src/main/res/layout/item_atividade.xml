<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_branco_arredondado"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAtividadeTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0f172a"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Troca de Óleo e Filtro" />

        <TextView
            android:id="@+id/tvAtividadeDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="14/10/2026 • 78.500 km • Posto Shell" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAtividadeValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="#0d9488"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="R$ 350,00" />

</LinearLayout>