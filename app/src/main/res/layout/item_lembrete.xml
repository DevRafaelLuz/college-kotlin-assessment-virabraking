<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_branco_arredondado_com_borda"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_verde_claro_arredondado"
        android:padding="10dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/vetor_menu_alertas"
        app:tint="#0d9488" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLembreteTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLembreteDataHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0d9488"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvLembreteDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/iBtnExcluirLembrete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/vetor_lixeira" />
</LinearLayout>
