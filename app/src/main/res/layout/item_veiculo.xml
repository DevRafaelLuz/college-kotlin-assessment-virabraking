<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llVeiculoItem"
    android:layout_width="match_parent"
    android:layout_height="114dp"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_branco_arredondado_com_borda"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivVeiculo"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:padding="28dp"
        android:tint="#0d9488"
        android:background="@drawable/bg_verde_claro_arredondado" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp">

        <TextView
            android:id="@+id/tvApelido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#64748b" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap"
            android:layout_marginTop="6dp"
            android:showDividers="middle">

            <TextView
                android:id="@+id/tvPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/bg_placa_veiculos"
                android:textColor="#0F172A"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/bg_verde_claro_arredondado"
                android:textColor="#0d9488"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/vetor_seta_direita"
        android:clickable="false"
        android:background="#ffffff" />
</LinearLayout>